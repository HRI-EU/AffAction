<Graph xmlns:xi="http://www.w3.org/2001/XInclude" name="default">

  <Body name="default_camera_view" transform="-1.676867 -1.658439 2.435608   -11.077 20.900 35.001"/>

  <!-- The Aruco markers are 1cm away from the borders of the table. -->
  <Body name="aruco_base" color="PEWTER" rigid_body_joints="true">
    <Shape extents="0.14 0.14 0" marker="true" markerName="aruco_0" scale="0.2" transform="0.31 0.31 1.00025 0 0 0"
           type="FRAME"/>
    <Shape type="BOX" extents="3.0 4.0 0.04" transform="0 0 -0.02 0 0 0" color="PEWTER"
           textureFile="textures/floor.jpg"
           graphics="true" physics="true" distance="false"/>
    <Shape scale="0.5" type="FRAME"/>
  </Body>

  <!-- The stand with the dual arm FR3 setup with Allegro hands. -->
  <Group prev="aruco_base" transform="0 0 0 0 0 0">
    <!-- <xi:include href="g_franka_with_allegro.xml"/> -->





    <Body name="stand" transform="0 0 0 0 0 0">
        <Shape type="BOX" extents="0.8 0.8 0.7175" graphics="true" distance="true" transform="0 0 0.51625 0 0 0"
               color="DARKGRAY"/>
    </Body>

    <Hardware name="arm_left" component="-frankaZmq_left -frankaZmq_left.ip 192.168.1.101"/>
    <Hardware name="arm_right" component="-frankaZmq_right -frankaZmq_right.ip 192.168.1.101"/>

    <!-- Dual arm FR3 setup -->
    <Group prev="stand" transform="0.284 0 0.875 0 0 0">
        <xi:include href="g_franka_duomount.xml"/>
    </Group>
    
    <Hardware name="hand_left" component="-allegroZmq_left -allegroZmq_left.ip 192.168.0.101 -allegroZmq_wrongThumb"/>
    <Hardware name="hand_right" component="-allegroZmq_right -allegroZmq_right.ip 192.168.0.101"/>

    <!-- Left Allegro hand -->
    <Group name="_left" prev="left_fr3_link8" transform="0 0 0 0 0 45">
        <xi:include href="../Allegro/g_hand_left.xml"/>

        <Body name="hand_robot" prev="hand_base" transform="0.06 0 -0.02 90 0 90">
            <Shape type="FRAME" scale="0.3"/>
        </Body>
        <Body name="hand_powergrasp" prev="hand_robot" transform="0 0 0 0 0 0">
            <Shape type="FRAME" scale="0.1"/>
        </Body>
        <Body name="hand_pincergrasp" prev="hand_robot" transform="0.05 -0.04 0 0 0 -60">
            <Shape type="FRAME" scale="0.15"/>
        </Body>

        <Manipulator body="hand_robot" types="hand hand_left allegro_left robot_0_hand_left">
            <Joints names="joint_0_0 joint_1_0 joint_2_0 joint_3_0 joint_4_0 joint_5_0 joint_6_0 joint_7_0 joint_8_0 joint_9_0 joint_10_0 joint_11_0 joint_12_0 joint_13_0 joint_14_0 joint_15_0"/>
            <PowergraspCapability frame="hand_powergrasp"/>
            <PincergraspCapability frame="hand_pincergrasp"/>
        </Manipulator>
    </Group>

    <!-- Right Allegro hand -->
    <Group name="_right" prev="right_fr3_link8" transform="0 0 0 0 0 45">
        <xi:include href="../Allegro/g_hand_right.xml"/>

        <Body name="hand_robot" prev="hand_base" transform="0.06 0 -0.02 -90 0 -90">
            <Shape type="FRAME" scale="0.3"/>
        </Body>
        <Body name="hand_powergrasp" prev="hand_robot" transform="0 -0.0 -0.0 0 -0 0">
            <Shape type="FRAME" scale="0.1"/>
        </Body>
        <Body name="hand_pincergrasp" prev="hand_robot" transform="0.05 0.04 0 0 0 60">
            <Shape type="FRAME" scale="0.15"/>
        </Body>

        <Manipulator body="hand_robot" types="hand hand_right allegro_right robot_0_hand_right">
            <Joints names="joint_0_0 joint_1_0 joint_2_0 joint_3_0 joint_4_0 joint_5_0 joint_6_0 joint_7_0 joint_8_0 joint_9_0 joint_10_0 joint_11_0 joint_12_0 joint_13_0 joint_14_0 joint_15_0"/>
            <PowergraspCapability frame="hand_powergrasp"/>
            <PincergraspCapability frame="hand_pincergrasp"/>
        </Manipulator>
    </Group>




































    
  </Group>

  <xi:include href="g_franka_with_allegro_model_states.xml" xpointer="xpointer(//Group/model_state)"/>
