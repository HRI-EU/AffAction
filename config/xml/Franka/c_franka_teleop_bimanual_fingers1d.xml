<Controller xmlns:xi="http://www.w3.org/2001/XInclude" >

  <xi:include href="g_franka_teleop.xml"/>

  <Task name="right_hand_xyz"   controlVariable="XYZ"   effector="hand_robot_right_tip" />
  <Task name="right_hand_abc"   controlVariable="ABC"   effector="hand_robot_right_tip" />
  <Task name="right_fingers_1d" controlVariable="Joint" jnt="joint_driving_right" />

  <Task name="left_hand_xyz"    controlVariable="XYZ"   effector="hand_robot_left_tip" />
  <Task name="left_hand_abc"    controlVariable="ABC"   effector="hand_robot_left_tip" />
  <Task name="left_fingers_1d"  controlVariable="Joint" jnt="joint_driving_left" />

  <BroadPhase DistanceThreshold="0.001">
    <Tree root="left_fr3_link1"/>
    <Tree root="right_fr3_link1"/>
    <Body name="franka_mount_link"/>
    <Body name="stand"/>
  </BroadPhase>

</Controller>
