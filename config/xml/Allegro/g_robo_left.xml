<Graph xmlns:xi="http://www.w3.org/2003/XInclude" resourcePath="${SIT}/Data/RobotMeshes/1.0/data" name="default" >
  
	<!-- The optional grapchics window camera perspective when starting up. -->
  <Body name="default_camera_view" transform="0.628586 -0.504824 -0.072022   -11.226 12.180 141.17"/>

  <Body name="base" >
    <Joint name="base_joint" range="-1 0 1" type="TransZ" />
	<Shape type="FRAME" />
  </Body>

  <Group name="_left" prev="base" >
    <xi:include href="g_hand_left.xml"/>
  </Group>


  <Manipulator body="palm_link_left" types="hand hand_left" >
