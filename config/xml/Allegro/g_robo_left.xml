    <PowergraspCapability frame="link_0_0_left" />
  </Manipulator>


  <!-- pointing - middle - ring - thumb from distal to proximal -->
  <model_state model="default" time_stamp="0">
    <joint_state joint="joint_0_0_left" position="2" />
