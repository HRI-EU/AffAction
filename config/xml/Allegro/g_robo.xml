<Graph xmlns:xi="http://www.w3.org/2003/XInclude" resourcePath="${SIT}/Data/RobotMeshes/1.0/data" name="default" >
  
	<!-- The optional grapchics window camera perspective when starting up. -->
  <Body name="default_camera_view" transform="0.628586 -0.504824 -0.072022   -11.226 12.180 141.17"/>

  <Body name="base" >
    <Joint name="base_joint" range="-1 0 1" type="TransZ" />
	<xShape type="FRAME" />
  </Body>

  <Group name="_right" prev="base" >
    <xi:include href="g_hand_right.xml"/>
  </Group>


  <Manipulator body="palm_link_right" types="hand hand_right" >
    <Joints names="joint_0_0_right joint_1_0_right joint_2_0_right joint_3_0_right joint_4_0_right joint_5_0_right joint_6_0_right joint_7_0_right joint_8_0_right joint_9_0_right joint_10_0_right joint_11_0_right joint_12_0_right joint_13_0_right joint_14_0_right joint_15_0_right"/>
    <PowergraspCapability frame="link_0_0_right" />
  </Manipulator>


  <!-- pointing - middle - ring - thumb from distal to proximal -->
  <model_state model="default" time_stamp="0">
    <joint_state joint="joint_0_0_right" position="2" />
