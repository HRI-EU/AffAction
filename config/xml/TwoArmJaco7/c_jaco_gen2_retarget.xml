<Controller xmlns:xi="http://www.w3.org/2001/XInclude" >

  <xi:include href="g_jaco_gen2_retarget.xml"/>

  <Task name="Right upperarm"  controlVariable="POLAR"   effector="forearm_right" refBdy="Seat_Felix" />
  <Task name="Right forearm"   controlVariable="POLAR"   effector="wrist_right"  refBdy="Seat_Felix" />
  <Task name="Right thumb"     controlVariable="ABC"   effector="hand_robot_right" refBdy="Seat_Felix" />
  <Task name="Left upperarm"   controlVariable="POLAR"   effector="forearm_left"   refBdy="Seat_Felix" /> 
  <Task name="Left forearm"    controlVariable="POLAR"   effector="wrist_left"   refBdy="Seat_Felix" />
  <Task name="Left thumb"      controlVariable="ABC"   effector="hand_robot_left"  refBdy="Seat_Felix" /> 
  <Task name="Head"            controlVariable="ABC"   effector="head_shell" refBdy="Seat_Felix" /> 

  <BroadPhase DistanceThreshold="0.001">
    <Tree root="upperarm_left"/>
    <Tree root="upperarm_right"/>
    <Body name="center_post_link"/>
    <Body name="stand"/>
  </BroadPhase>
	
</Controller>
