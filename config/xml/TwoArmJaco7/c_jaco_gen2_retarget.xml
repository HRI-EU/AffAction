<Controller xmlns:xi="http://www.w3.org/2001/XInclude" >

  <xi:include href="g_jaco_gen2_retarget.xml"/>

  <Task name="right_upperarm_ori"  controlVariable="POLAR"   effector="upperarm_retarget_right"    refBdy="Seat_Felix" />
  <Task name="right_forearm_ori"   controlVariable="POLAR"   effector="wrist_retarget_right"      refBdy="Seat_Felix" />
  <Task name="right_hand_ori"      controlVariable="POLAR"   effector="hand_retarget_right" refBdy="Seat_Felix" />
  <Task name="left_upperarm_ori"   controlVariable="POLAR"   effector="upperarm_retarget_left"     refBdy="Seat_Felix" />
  <Task name="left_forearm_ori"    controlVariable="POLAR"   effector="wrist_retarget_left"       refBdy="Seat_Felix" />
  <Task name="left_hand_ori"       controlVariable="POLAR"   effector="hand_retarget_left"  refBdy="Seat_Felix" />
  <Task name="head_ori"            controlVariable="POLAR"   effector="head_retarget"             refBdy="Seat_Felix" />

  <BroadPhase DistanceThreshold="0.001">
    <Tree root="upperarm_left"/>
    <Tree root="upperarm_right"/>
    <Body name="center_post_link"/>
    <Body name="stand"/>
  </BroadPhase>
	
</Controller>
