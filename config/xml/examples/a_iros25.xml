<Action name="high_pose" >

<Task name="hand_right" controlVariable="XYZ" effector="hand_right_pincergrasp" refBdy="table_0" active="true" />
<Task name="hand_left"  controlVariable="XYZ" effector="hand_left_pincergrasp"  refBdy="table_0" active="true" />
<Task name="fingers_left"  controlVariable="Joints" jnts="j2s7s300_joint_finger_1_left j2s7s300_joint_finger_2_left j2s7s300_joint_finger_3_left" />
<Task name="fingers_right" controlVariable="Joints" jnts="j2s7s300_joint_finger_1_right j2s7s300_joint_finger_2_right j2s7s300_joint_finger_3_right" />


<ConstraintSet type="ActivationSet" >
	<Activation t="0.05" switchesOn="true"  horizon="0.5" trajectory="hand_right" />
	<Activation t="8"    switchesOn="false" horizon="0.5" trajectory="hand_right" />
	<Activation t="0.05" switchesOn="true"  horizon="0.5" trajectory="fingers_right" />
	<Activation t="8"    switchesOn="false" horizon="0.5" trajectory="fingers_right" />
	<Activation t="0.05" switchesOn="true"  horizon="0.5" trajectory="hand_left" />
	<Activation t="8"    switchesOn="false" horizon="0.5" trajectory="hand_left" />
	<Activation t="0.05" switchesOn="true"  horizon="0.5" trajectory="fingers_left" />
	<Activation t="8"    switchesOn="false" horizon="0.5" trajectory="fingers_left" />

	<ConstraintSet type="PositionConstraint" t="4" pos="0 0 0.2" trajectory="hand_right" />
	<ConstraintSet type="PositionConstraint" t="8" pos="-0.20 0 0.4" trajectory="hand_right" />

</ConstraintSet>

</Action>
